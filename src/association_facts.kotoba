(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count topic by-topic-count by-topic-id]))
(defn association-covered? [a :string] :i64 (string=? a "zenginkyo"))
(defn entry-count [a :string] :i64 (if (association-covered? a) 2 0))
(defn valid-entry? [a :string i :i64] :i64
  (if (association-covered? a) (if (= i 0) 1 (if (= i 1) 1 0)) 0))
(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (if (= i 0)
      (cond
        (string=? f "id") (option-some-of [:option :string] "zenginkyo.code-of-conduct")
        (string=? f "title") (option-some-of [:option :string] "Code of Conduct (倫理憲章)")
        (string=? f "association") (option-some-of [:option :string] "zenginkyo")
        (string=? f "isic") (option-some-of [:option :string] "6419")
        (string=? f "country") (option-some-of [:option :string] "JPN")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "https://www.zenginkyo.or.jp/en/conduct/")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "established-date") (option-some-of [:option :string] "2005-11-22")
        (string=? f "last-revised-date") (option-some-of [:option :string] "2022-09-15")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-14")
        :else (option-none-of [:option :string]))
      (cond
        (string=? f "id") (option-some-of [:option :string] "zenginkyo.agreements")
        (string=? f "title") (option-some-of [:option :string] "申し合わせ (Board-resolved Member-Bank Arrangements)")
        (string=? f "association") (option-some-of [:option :string] "zenginkyo")
        (string=? f "isic") (option-some-of [:option :string] "6419")
        (string=? f "country") (option-some-of [:option :string] "JPN")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "https://www.zenginkyo.or.jp/agreement/")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-14")
        :else (option-none-of [:option :string])))
    (option-none-of [:option :string])))
(defn topic-count [a :string i :i64] :i64 (if (valid-entry? a i) 2 0))
(defn topic [a :string i :i64 ti :i64] [:option :string]
  (if (valid-entry? a i)
    (if (= i 0)
      (if (= ti 0) (option-some-of [:option :string] "ethics")
        (if (= ti 1) (option-some-of [:option :string] "member-conduct") (option-none-of [:option :string])))
      (if (= ti 0) (option-some-of [:option :string] "consumer-protection")
        (if (= ti 1) (option-some-of [:option :string] "fair-transaction") (option-none-of [:option :string]))))
    (option-none-of [:option :string])))
(defn by-topic-count [a :string t :string] :i64
  (if (association-covered? a)
    (if (string=? t "ethics") 1
      (if (string=? t "member-conduct") 1
        (if (string=? t "consumer-protection") 1 (if (string=? t "fair-transaction") 1 0))))
    0))
(defn by-topic-id [a :string t :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (= i 0)
      (if (string=? t "ethics") (entry-field a 0 "id")
        (if (string=? t "member-conduct") (entry-field a 0 "id")
          (if (string=? t "consumer-protection") (entry-field a 1 "id")
            (if (string=? t "fair-transaction") (entry-field a 1 "id") (option-none-of [:option :string])))))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))
(defn main [] :i64 0)
