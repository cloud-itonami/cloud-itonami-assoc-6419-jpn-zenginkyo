(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count topic
            by-topic-count by-topic-id disposition-count sets-numeric-default-count]))

(defn association-covered? [a :string] :i64 (string=? a "zenginkyo"))
(defn entry-count [a :string] :i64 (if (association-covered? a) 6 0))
(defn valid-entry? [a :string i :i64] :i64
  (if (association-covered? a) (if (< i 6) (if (< i 0) 0 1) 0) 0))

;; --------------------------------------------------------------------------
;; Per-entry field tables. Internal accessors return a plain :string and use
;; "" for "this entry does not carry that field" -- the exported `entry-field`
;; wraps that single sentinel into [:option :string] exactly once, instead of
;; every branch re-deriving an option. No stored field value is ever "".
;; --------------------------------------------------------------------------

(defn field-0 [f :string] :string
  (cond
    (string=? f "id") "zenginkyo.code-of-conduct"
    (string=? f "title") "Code of Conduct (倫理憲章)"
    (string=? f "association") "zenginkyo"
    (string=? f "isic") "6419"
    (string=? f "country") "JPN"
    (string=? f "kind") "self-regulatory-code"
    (string=? f "url") "https://www.zenginkyo.or.jp/en/conduct/"
    (string=? f "url-provenance") "official-association-site"
    (string=? f "established-date") "2005-11-22"
    (string=? f "last-revised-date") "2022-09-15"
    (string=? f "retrieved-at") "2026-07-14"
    (string=? f "addressee") "member-bank"
    (string=? f "parameter-disposition") "no-parameter"
    :else ""))

(defn field-1 [f :string] :string
  (cond
    (string=? f "id") "zenginkyo.agreements"
    (string=? f "title") "申し合わせ (Board-resolved Member-Bank Arrangements)"
    (string=? f "association") "zenginkyo"
    (string=? f "isic") "6419"
    (string=? f "country") "JPN"
    (string=? f "kind") "self-regulatory-code"
    (string=? f "url") "https://www.zenginkyo.or.jp/agreement/"
    (string=? f "url-provenance") "official-association-site"
    (string=? f "retrieved-at") "2026-07-14"
    (string=? f "addressee") "member-bank"
    (string=? f "parameter-disposition") "no-parameter"
    :else ""))

(defn field-2 [f :string] :string
  (cond
    (string=? f "id") "zenginkyo.corporate-ib-unauthorized-withdrawal-response"
    (string=? f "title") "法人向けインターネット・バンキングに係る預金等の不正な払戻しへの対応について"
    (string=? f "association") "zenginkyo"
    (string=? f "isic") "6419"
    (string=? f "country") "JPN"
    (string=? f "kind") "self-regulatory-code"
    (string=? f "url") "https://www.zenginkyo.or.jp/news/2014/n3344/"
    (string=? f "url-provenance") "official-association-site"
    (string=? f "established-date") "2014-05-15"
    (string=? f "retrieved-at") "2026-07-29"
    (string=? f "addressee") "member-bank"
    (string=? f "parameter-disposition") "delegates-to-adopter"
    :else ""))

(defn field-3 [f :string] :string
  (cond
    (string=? f "id") "zenginkyo.corporate-ib-compensation"
    (string=? f "title") "法人向けインターネット・バンキングにおける預金等の不正な払戻しに関する補償の考え方について"
    (string=? f "association") "zenginkyo"
    (string=? f "isic") "6419"
    (string=? f "country") "JPN"
    (string=? f "kind") "self-regulatory-code"
    (string=? f "url") "https://www.zenginkyo.or.jp/news/2014/n3349/"
    (string=? f "url-provenance") "official-association-site"
    (string=? f "established-date") "2014-07-17"
    (string=? f "retrieved-at") "2026-07-29"
    (string=? f "addressee") "member-bank"
    (string=? f "parameter-disposition") "conditions-liability-on-adopter-choice"
    :else ""))

(defn field-4 [f :string] :string
  (cond
    (string=? f "id") "zenginkyo.financial-crime-response"
    (string=? f "title") "金融犯罪への対応の徹底に係る申し合わせについて"
    (string=? f "association") "zenginkyo"
    (string=? f "isic") "6419"
    (string=? f "country") "JPN"
    (string=? f "kind") "self-regulatory-code"
    (string=? f "url") "https://www.zenginkyo.or.jp/news/2024/n051001/"
    (string=? f "url-provenance") "official-association-site"
    (string=? f "established-date") "2024-05-10"
    (string=? f "retrieved-at") "2026-07-29"
    (string=? f "addressee") "member-bank"
    (string=? f "parameter-disposition") "no-parameter"
    :else ""))

(defn field-5 [f :string] :string
  (cond
    (string=? f "id") "zenginkyo.corporate-ib-fraud-alert"
    (string=? f "title") "法人向けインターネット・バンキングにおける不正送金にご注意！"
    (string=? f "association") "zenginkyo"
    (string=? f "isic") "6419"
    (string=? f "country") "JPN"
    (string=? f "kind") "public-guidance"
    (string=? f "url") "https://www.zenginkyo.or.jp/topic/detail/nid/3563/"
    (string=? f "url-provenance") "official-association-site"
    (string=? f "retrieved-at") "2026-07-29"
    (string=? f "addressee") "corporate-customer"
    (string=? f "parameter-disposition") "delegates-to-adopter"
    :else ""))

(defn field [a :string i :i64 f :string] :string
  (if (valid-entry? a i)
    (cond
      (= i 0) (field-0 f)
      (= i 1) (field-1 f)
      (= i 2) (field-2 f)
      (= i 3) (field-3 f)
      (= i 4) (field-4 f)
      :else (field-5 f))
    ""))

(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (string=? (field a i f) "")
    (option-none-of [:option :string])
    (option-some-of [:option :string] (field a i f))))

;; --------------------------------------------------------------------------
;; Topics
;; --------------------------------------------------------------------------

(defn topic-count [a :string i :i64] :i64 (if (valid-entry? a i) 2 0))

(defn topic-at [a :string i :i64 ti :i64] :string
  (if (valid-entry? a i)
    (cond
      (= i 0) (if (= ti 0) "ethics" (if (= ti 1) "member-conduct" ""))
      (= i 1) (if (= ti 0) "consumer-protection" (if (= ti 1) "fair-transaction" ""))
      (= i 2) (if (= ti 0) "corporate-internet-banking" (if (= ti 1) "transfer-limit" ""))
      (= i 3) (if (= ti 0) "corporate-internet-banking" (if (= ti 1) "compensation" ""))
      (= i 4) (if (= ti 0) "financial-crime" (if (= ti 1) "member-conduct" ""))
      :else (if (= ti 0) "corporate-internet-banking" (if (= ti 1) "transfer-limit" "")))
    ""))

(defn topic [a :string i :i64 ti :i64] [:option :string]
  (if (string=? (topic-at a i ti) "")
    (option-none-of [:option :string])
    (option-some-of [:option :string] (topic-at a i ti))))

(defn entry-has-topic? [a :string i :i64 t :string ti :i64] :i64
  (if (< ti (topic-count a i))
    (if (string=? (topic-at a i ti) t) 1 (entry-has-topic? a i t (+ ti 1)))
    0))

;; --------------------------------------------------------------------------
;; Scans. Counts are DERIVED from the tables above rather than restated, so a
;; catalog entry cannot be added without the counts moving with it.
;; --------------------------------------------------------------------------

(defn topic-scan [a :string t :string i :i64] :i64
  (if (< i (entry-count a))
    (+ (entry-has-topic? a i t 0) (topic-scan a t (+ i 1)))
    0))

(defn by-topic-count [a :string t :string] :i64 (topic-scan a t 0))

(defn nth-with-topic [a :string t :string n :i64 i :i64] :i64
  (if (< i (entry-count a))
    (if (= (entry-has-topic? a i t 0) 1)
      (if (= n 0) i (nth-with-topic a t (- n 1) (+ i 1)))
      (nth-with-topic a t n (+ i 1)))
    (entry-count a)))

(defn by-topic-id [a :string t :string i :i64] [:option :string]
  (entry-field a (nth-with-topic a t i 0) "id"))

;; --------------------------------------------------------------------------
;; Parameter disposition -- the association-layer question this catalog exists
;; to answer for a given topic: does the association FIX the number, or does it
;; name the parameter and hand the number to whoever adopts the rule?
;;
;; `disposition-count` is a plain count over the tables. It asserts nothing
;; about what the association SHOULD do; a caller reading
;; `sets-numeric-default-count` = 0 for a topic is reading an absence in the
;; published record, not a recommendation.
;; --------------------------------------------------------------------------

(defn disposition-scan [a :string t :string d :string i :i64] :i64
  (if (< i (entry-count a))
    (+ (if (= (entry-has-topic? a i t 0) 1)
         (if (string=? (field a i "parameter-disposition") d) 1 0)
         0)
       (disposition-scan a t d (+ i 1)))
    0))

(defn disposition-count [a :string t :string d :string] :i64
  (disposition-scan a t d 0))

(defn sets-numeric-default-count [a :string t :string] :i64
  (disposition-scan a t "sets-numeric-default" 0))

(defn main [] :i64 0)
